# Local Postgres, or Render's External Database URL to reach the Render DB from your machine.
# On the Render web service itself, use the Internal Database URL.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/localbloom
PORT=3001

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me
# From your GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Local app callback:  http://localhost:5173/auth/github/callback
# Render app callback: https://<your-app>.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback
# Alternative to DATABASE_URL (only used when DATABASE_URL is not set)
PGUSER="xxxxxxxxxxxx"
PGPASSWORD="xxxxxxxxxxxxx"
PGHOST="xxxxxxxxxxxxxxxx-a.virginia-postgres.render.com"
PGPORT=5432
PGDATABASE="xxxxxxx"